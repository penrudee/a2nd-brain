{
  "schema": 2,
  "permissions": [
    "tools.invoke"
  ],
  "required_executas": [
    {
      "tool_id": "tool-dev-a2nd-brain",
      "min_version": "0.1.0",
      "version": "latest"
    }
  ],
  "tags": ["a2nd-brain"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "a2nd-brain",
        "default": true,
        "entry": "index.html",
        "default_size": { "w": 1200, "h": 600 },
        "min_size": { "w": 320, "h": 240 }
      }
    ],
    "host_api": {
      "storage": ["get", "set"],
      "window": ["set_title", "ready"],
      "llm": ["complete"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}